# NØVA — environment variables
# Never prefix AI provider keys with NEXT_PUBLIC_ — they must stay server-side.

# AI fabric (NVIDIA NIM/API) — free, no funded account required. Also exposes
# DeepSeek's own model (deepseek-ai/deepseek-v4.1-flash) alongside others, so
# a separate paid direct-to-DeepSeek provider isn't needed.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase (core backend)
# The publishable (anon) key is safe in the browser bundle — RLS restricts
# what it can actually read/write. The service role key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Specialized (non-AI) tools — Level 2 executors, no LLM involved
# Brave Search API: free tier, 2,000 queries/month, no card required.
# https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Wandbox code execution sandbox: free, keyless, publicly hosted.
# https://wandbox.org (Piston's public API went whitelist-only in 2/2026)
WANDBOX_API_URL=https://wandbox.org/api/compile.json
