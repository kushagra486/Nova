# NØVA — environment variables
# Never prefix AI provider keys with NEXT_PUBLIC_ — they must stay server-side.

# Primary AI fabric (NVIDIA NIM/API)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Secondary provider (DeepSeek API)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# Supabase (core backend)
# The publishable (anon) key is safe in the browser bundle — RLS restricts
# what it can actually read/write. The service role key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
